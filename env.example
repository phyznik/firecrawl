# env.example — copy to .env and edit the values you want to change
#   cp env.example .env
#
# `docker compose up -d` reads the root .env. Every variable referenced by
# `compose.yaml` is listed below. `:-` = optional default (leave unset to use it).
#
# ===========================================================================
# REQUIRED — API will not start (no defaults provided in compose.yaml)
# ===========================================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=
AUTUMN_SECRET_KEY=
NUQ_BACKEND=pg                 # 'pg' (default) or 'fdb'

# ===========================================================================
# AI / model provider (only set if a feature needs a provider)
# ===========================================================================
OLLAMA_BASE_URL=               # e.g. http://localhost:11434

# ===========================================================================
# Queues
# ===========================================================================
# RATELIMIT: redis://redis:6379   (default; set REDIS_RATE_LIMIT_URL to override)
# BROWSER: -- (no default in compose.yaml)

# ===========================================================================
# Admin routes (optional; key-protected on the API port)
# ===========================================================================
BULL_AUTH_KEY=                 # unset => admin routes are disabled
BULL_AUTH_KEY_PREVIOUS=        # optional; second accepted bearer value
BULL_AUTH_KEY_PATH_ROUTES=true # true keeps /admin/<key>/... routes

# Internal (keyless) admin listener — never publish this port
ADMIN_INTERNAL_PORT=
ADMIN_INTERNAL_HOST=localhost

# ===========================================================================
# Webhooks / integrations
# ===========================================================================
SLACK_WEBHOOK_URL=
SELF_HOSTED_WEBHOOK_URL=

# ===========================================================================
# Database (defaults match compose.yaml; only override when needed)
# ===========================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=nuq-postgres
POSTGRES_PORT=5432

# ===========================================================================
# Search (SearXNG) — optional; unset => default engine list is used
# ===========================================================================
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=

# ===========================================================================
# Network / proxy (optional)
# ===========================================================================
PROXY_SERVER=                  # e.g. http://proxy:8080
PROXY_USERNAME=
PROXY_PASSWORD=
ALLOW_LOCAL_WEBHOOKS=
BLOCK_MEDIA=
HARNESS_STARTUP_TIMEOUT_MS=60000

# ===========================================================================
# Misc
# ===========================================================================
LOGGING_LEVEL=info
TEST_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_TOKEN=
SUPABASE_SERVICE_TOKEN=
CERTIFICATE_AUTHORITY_PATH=
